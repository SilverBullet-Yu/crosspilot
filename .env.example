# 记录模板：项目没有 dotenv，脚本不会自动加载本文件；运行前请将所需变量导出到当前 shell。
# 数据模式：snapshot（默认，Demo 用，只读 data/snapshots）或 live（实时调用，消耗配额）
CROSSPILOT_DATA_MODE=snapshot

# 知乎开放平台 Access Secret，自助生成于 https://developer.zhihu.com/profile
# 实测额度：搜索 10 次/日、热榜 2 次/日、直答 2 次/日
ZHIHU_ACCESS_SECRET=

# UN Comtrade 订阅密钥，硬约束 4：禁止匿名 preview 调用
COMTRADE_SUBSCRIPTION_KEY=

# 可替换的文本推理 API（OpenAI 兼容 chat/completions，LLM 立场抽取用，ADR-0004）
# 三项须齐备：API 基址（如 https://open.deepseek.com/v1）、密钥、模型名（如 deepseek-chat）
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# 前端（apps/web）数据源：留空或 "fixtures" 读本地夹具；如 http://localhost:8000 调真实 FastAPI
NUXT_PUBLIC_API_BASE=fixtures
